{
  "schemaVersion": 1,
  "id": "lg2-client",
  "version": "${version}",
  "name": "Lostglade Client",
  "description": "Lostglade client: race abilities, drone camera tilt, and GPU camera rendering.",
  "environment": "client",
  "entrypoints": {
    "client": ["com.lostglade.Lg2Client"]
  },
  "mixins": [
    "lg2.client.mixins.json",
    "lg2.absolute_invisibility.client.mixins.json",
    "lg2-race-client.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.18.4",
    "minecraft": "~1.21.11",
    "java": ">=21",
    "fabric-api": "*"
  }
}
