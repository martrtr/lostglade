[Unit]
Description=Lostglade consistent backup and scheduled restart
After=network-online.target
Wants=network-online.target
ConditionPathExists=/srv/lostglade/current

[Service]
Type=oneshot
User=root
ExecStart=/usr/local/sbin/lostglade-maintenance
TimeoutStartSec=30min
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
